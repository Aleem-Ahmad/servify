// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Servify database — Supabase PostgreSQL only (see README.md)
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id @default(uuid())
  username         String    @unique
  name             String
  email            String    @unique
  password         String?
  googleId         String?   @unique
  
  verifyCode       String
  verifyCodeExpiry DateTime
  isVerified       Boolean   @default(false)
  
  // Documents (Stored as JSON or structured)
  documents        Json?     // { cnicFront, cnicBack, skillDemo, addressProof }
  
  role             String    @default("customer") // 'customer', 'provider', 'admin'
  status           String    @default("Active") // 'Active', 'Pending', 'Blocked'
  surveyDate       DateTime?
  warning          String    @default("")
  
  // Provider fields
  trustScore       Int       @default(0)
  badge            String    @default("Basic") // 'Basic', 'Pro', 'Elite'
  performance      Json?     // { rating, completedJobs, avgResponseTime, complaintHistory, leaderboardPoints }
  
  isOnline         Boolean   @default(false)
  hourlyRate       Float     @default(0)

  
  // Location as JSON or separate lat/long fields
  location         Json?     // { type: 'Point', coordinates: [lng, lat] }
  
  subscription     Json?     // { plan, expiryDate }
  
  phone            String?
  district         String?
  tehseel          String?
  cnic             String?
  address          String?
  gender           String?
  religion         String?
  maritalStatus    String?
  dob              String?
  category         String?
  experience       String?
  providerType     String?
  services         Json?     // Array of service name strings
  image            String?
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  schedule          Schedule?   @relation("UserSchedule")
  offers           Offer[]      @relation("UserOffers")
  teamMembers      TeamMember[] @relation("TeamMembers")
  // Relations
  customerBookings Booking[] @relation("CustomerBookings")
  providerBookings Booking[] @relation("ProviderBookings")
  reviewsGiven     Review[]  @relation("ReviewsGiven")
  reviewsReceived  Review[]  @relation("ReviewsReceived")
  sentMessages      ChatMessage[] @relation("ChatMessageSender")
  bargainOffersProposed BargainOffer[] @relation("BargainProposer")
}

model Booking {
  id               String    @id @default(uuid())
  customerId       String
  providerId       String?

  service          String
  details          String?
  voiceUrl         String?
  mediaUrls        String[]  // Array of strings
  budget           Float     @default(0)
  hours            Float     @default(1)
  hourlyRate       Float     @default(0)

  customerName     String?
  customerPhone    String?
  customerAddress  String?
  locationStr      String?

  providerName     String?
  providerPhone    String?

  date             DateTime?
  visitTime        DateTime?

  status           String    @default("Pending") // 'Pending', 'Accepted', 'In-Progress', 'Completed', 'Cancelled'
  urgency          String    @default("Normal") // 'Normal', 'Urgent', 'Emergency'

  guarantee        Json?     // { isActive, expiryTime, reworked, refunded }
  tracking         Json?     // { providerLocation, eta }
  payment          Json?     // { method, status, transactionId, convenienceFee }

  otp              String?

  // Bargaining system fields
  bargainingStatus String    @default("None") // 'None', 'Negotiating', 'Agreed', 'Rejected'
  agreedPrice      Float?
  finalPrice       Float?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  customer         User      @relation("CustomerBookings", fields: [customerId], references: [id])
  provider         User?     @relation("ProviderBookings", fields: [providerId], references: [id])
  reviews          Review[]
  chatMessages     ChatMessage[]
  bargainOffers    BargainOffer[]
}

model ChatMessage {
  id        String   @id @default(uuid())
  bookingId String
  senderId  String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender    User     @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([senderId])
}

model Review {
  id               String    @id @default(uuid())
  bookingId        String
  customerId       String
  providerId       String
  
  rating           Int
  comment          String?
  mediaUrls        String[]
  voiceUrl         String?
  isFlagged        Boolean   @default(false)
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  // Relations
  booking          Booking   @relation(fields: [bookingId], references: [id])
  customer         User      @relation("ReviewsGiven", fields: [customerId], references: [id])
  provider         User      @relation("ReviewsReceived", fields: [providerId], references: [id])
}

model VerifyCode {
  id               String    @id @default(uuid())
  email            String
  code             String
  expiresAt        DateTime
}

model Schedule {
  id          String   @id @default(uuid())
  providerId  String   @unique
  startHour   Int      // 0-24
  endHour     Int
  daysOfWeek  Int[]    // 0=Sun .. 6=Sat
  provider    User @relation("UserSchedule", fields: [providerId], references: [id])
}

model Offer {
  id          String   @id @default(uuid())
  providerId  String
  title       String
  description String?
  discountPct Float?
  discountAmt Float?
  validFrom   DateTime
  validTo     DateTime
  serviceIds  String[]
  provider    User @relation("UserOffers", fields: [providerId], references: [id])
}

model BargainOffer {
  id           String   @id @default(uuid())
  bookingId    String
  proposerId   String
  proposerType String   // 'customer' or 'provider'
  proposedPrice Float
  message      String?
  status       String   @default("Pending") // 'Pending', 'Accepted', 'Rejected', 'Countered'
  createdAt    DateTime @default(now())

  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  proposer     User     @relation("BargainProposer", fields: [proposerId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([proposerId])
}

model TeamMember {
  id         String   @id @default(uuid())
  providerId String
  name       String
  role       String   @default("Technician") // 'Technician', 'Supervisor', 'Admin'
  phone      String?
  cnic       String?
  status     String   @default("Active")
  createdAt  DateTime @default(now())
  provider   User     @relation("TeamMembers", fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}
